# Modelo de variáveis de ambiente. Copie para .env e preencha todos os valores.
# Senha dos bancos Postgres (todos usam a mesma, o usuário é "safer")
DB_PASSWORD=

# Usuário e senha do RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Chave de assinatura dos tokens JWT. Mínimo de 32 caracteres.
JWT_SECRET=

# Primeiro administrador, criado ao subir o usuarios-service se o e-mail ainda não existir.
ADMIN_EMAIL=
ADMIN_SENHA=
